rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /bridge_scope_records_v3/{id} {
   allow read: if request.auth != null;
   allow create, update: if request.auth != null && request.resource.data.bridgeCode == id && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
  }
  match /bridge_scope_custom_bridges_v3/{id} {
   allow read: if request.auth != null;
   allow create, update: if request.auth != null && request.resource.data.code == id && request.resource.data.createdBy == request.auth.uid && request.resource.data.lat is number && request.resource.data.lng is number;
  }
  // Round 4 writes cannot reach the previous survey collections.
  match /bridge_scope_round4_records/{id} {
   allow read: if request.auth != null;
   allow create, update: if request.auth != null && request.resource.data.surveyRound == 4 && request.resource.data.bridgeCode == id && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time && ((request.resource.data.lat == null && request.resource.data.lng == null) || (request.resource.data.lat is number && request.resource.data.lng is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90 && request.resource.data.lng >= -180 && request.resource.data.lng <= 180));
  }
  match /bridge_scope_round4_custom_bridges/{id} {
   allow read: if request.auth != null;
   allow create, update: if request.auth != null && request.resource.data.code == id && request.resource.data.createdBy == request.auth.uid && request.resource.data.lat is number && request.resource.data.lng is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90 && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;
  }
 }
}
